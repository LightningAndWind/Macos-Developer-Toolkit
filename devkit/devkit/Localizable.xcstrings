            "value" : "\"%@\" and all folders and requests inside it will be deleted. This cannot be undone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」及其内部的全部文件夹与请求将被一并删除，此操作不可撤销。"
          }
        }
      }
    },
